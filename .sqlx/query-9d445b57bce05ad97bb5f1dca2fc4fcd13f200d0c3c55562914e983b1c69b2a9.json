{
  "db_name": "SQLite",
  "query": "SELECT c.id, c.post_id, c.parent_id, c.reply_to_id, c.status, c.body, c.author_id,\n                    c.guest_name, c.guest_pw_hash, c.actor_type, c.created_at, c.updated_at, c.image\n             FROM comments c\n             JOIN posts p ON p.id = c.post_id\n             JOIN boards b ON b.id = p.board_id\n             JOIN roles r ON r.name = json_extract(b.policy, '$.read')\n             WHERE c.author_id = ?1 AND c.status = 'published'\n               AND p.status = 'published' AND p.is_secret = 0 AND r.rank <= ?2\n             ORDER BY c.created_at DESC, c.id DESC LIMIT ?3",
